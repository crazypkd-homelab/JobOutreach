{
  "name": "joboutreach",
  "private": true,
  "version": "0.1.0",
  "license": "PolyForm-Noncommercial-1.0.0",
  "packageManager": "pnpm@10.33.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "pnpm -r --parallel --filter ./packages/server --filter ./packages/web dev",
    "build": "pnpm -r --filter ./packages/shared --filter ./packages/web --filter ./packages/server build",
    "start": "node packages/server/dist/index.js",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion": "^5.0.9",
      "ip-address": "^10.3.1",
      "tar": "^7.5.21",
      "undici": "^6.28.0"
    }
  }
}
